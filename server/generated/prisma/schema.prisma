model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  scenes  Scene[]

  @@index([userId])
  @@map("projects")
}

enum ProjectRole {
  VIEWER
  EDITOR
  OWNER
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Scene {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    SimulationRun[]

  @@index([projectId])
  @@map("scenes")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum SimulationRunStatus {
  RUNNING
  COMPLETED
  INTERRUPTED
}

model SimulationRun {
  id              String              @id @default(uuid()) @db.Uuid
  sceneId         String              @map("scene_id") @db.Uuid
  setup           Json
  engineVersion   Int                 @map("engine_version")
  status          SimulationRunStatus @default(RUNNING)
  lastTick        Int                 @default(0) @map("last_tick")
  startedAt       DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime            @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(6)

  scene       Scene                  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  chunks      SimulationRunChunk[]
  checkpoints SimulationCheckpoint[]
  metrics     SimulationMetric[]

  @@index([sceneId, startedAt])
  @@index([status, lastHeartbeatAt])
  @@map("simulation_runs")
}

model SimulationRunChunk {
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  fromTick  Int      @map("from_tick")
  toTick    Int      @map("to_tick")
  commands  Json
  events    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, seq])
  @@index([runId, fromTick])
  @@map("simulation_run_chunks")
}

model SimulationCheckpoint {
  runId String @map("run_id") @db.Uuid
  tick  Int
  hash  String
  state Json

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, tick])
  @@map("simulation_checkpoints")
}

model SimulationMetric {
  runId  String @map("run_id") @db.Uuid
  tick   Int
  values Json

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, tick])
  @@map("simulation_metrics")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  username     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions Session[]
  projects Project[]
  members  ProjectMember[]

  @@map("users")
}
